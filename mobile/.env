# API Base URL configuration for Flutter app.
# Toggle between local backend and deployed staging server.
#
# To run with these settings:
#   flutter run --dart-define-from-file=.env
# (VS Code is configured to load this automatically when you hit F5)

# Option 1: Local Backend (USB adb reverse or emulator loopback)
# API_URL=http://127.0.0.1:5000

# Option 2: Staging Backend (Deployed Server)
API_URL=http://staging.thirdeyegfx.in/butterfly_backend
