# ─── Flask ────────────────────────────────────────────
FLASK_APP=manage.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# ─── Database ─────────────────────────────────────────
# Option 1: Local Postgres Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/butterfly_db

# Option 2: Deployed Staging Database (Direct Remote Access - if server firewall allows)
# DATABASE_URL=postgresql://staging_user:staging_password@staging_host:5432/staging_db

# Option 3: Deployed Staging Database (Localhost - when running on the server or via SSH tunnel)
# DATABASE_URL=postgresql://staging_user:staging_password@localhost:5432/staging_db

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Bunny Storage ────────────────────────────────────
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_REGION=de              # de, ny, la, sg, syd
BUNNY_CDN_URL=https://your-pullzone.b-cdn.net

# ─── Gemini AI ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ─── OpenAI Vision (optional fallback; requires prepaid balance) ──────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_DETAIL=high

# ─── Local uploads dir (optional) ─────────────────────
# On cPanel set to /home/<user>/uploads so files survive redeploys.
# Leave blank for the dev-friendly ./uploads folder.
UPLOAD_DIR=

# ─── CORS (prod only — comma-separated allowed origins) ─
# CORS_ORIGINS=https://admin.yoursite.com,https://yoursite.com

# ─── Firebase FCM ─────────────────────────────────────
FIREBASE_SERVER_KEY=your-firebase-server-key

# ─── Upload Limits ────────────────────────────────────
MAX_CONTENT_LENGTH=10485760          # 10 MB
MAX_IMAGES_PER_OBSERVATION=5

# ─── Superadmin Seed Credentials ──────────────────────
SUPERADMIN_EMAIL=superadmin@butterfly.org
SUPERADMIN_PASSWORD=BflySuperAdmin#2026
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_USERNAME=superadmin
